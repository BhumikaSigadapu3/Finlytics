# Copy to .env in the project root for Docker Compose
# cp .env.docker.example .env

JWT_SECRET=use-a-long-random-string-in-production
JWT_EXPIRES_IN=30d
SSO_SESSION_DAYS=30

# URL where users open the app in the browser
CLIENT_ORIGIN=http://localhost:8080

# Optional SMTP (password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Finlytics <noreply@example.com>
