# MongoDB — use database name test1 (separate from other projects on same cluster)
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/test1
# Atlas (append /test1 before query string):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/test1?appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/test1

# JWT secret — use a long random string in production
JWT_SECRET=change-this-to-a-secure-random-string

# SSO session: JWT valid for 30 days (single sign-on)
JWT_EXPIRES_IN=30d
SSO_SESSION_DAYS=30

# Server port
PORT=5000

# Optional: comma-separated origins for CORS (defaults to http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Optional SMTP for password reset emails (otherwise link is logged in dev)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM="Finlytics <your@gmail.com>"
